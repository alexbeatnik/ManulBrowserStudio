{
  "name": "manul-browser-studio",
  "productName": "Manul Browser Studio",
  "version": "0.1.0",
  "description": "A desktop IDE for Manul Browser: write .hunt files, run them with live results, step through them, and look at the page they drive.",
  "license": "Apache-2.0",
  "author": "Oleksii Poliakov",
  "repository": {
    "type": "git",
    "url": "https://github.com/alexbeatnik/ManulBrowserStudio"
  },
  "homepage": "https://github.com/alexbeatnik/ManulBrowserStudio",
  "private": true,
  "main": "dist/main.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "npm run build && electron .",
    "test": "tsc -p tsconfig.test.json && node --test \"out-test/test/*.test.js\"",
    "smoke": "npm run build && electron . --smoke",
    "dsl": "node scripts/sync-dsl.mjs",
    "dist": "node scripts/build.mjs --production && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "manul-browser": "^0.1.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "monaco-editor": "^0.57.0",
    "npm": "^12.2.0",
    "typescript": "^5.7.0"
  },
  "build": {
    "appId": "io.github.alexbeatnik.manul-browser-studio",
    "productName": "Manul Browser Studio",
    "copyright": "Copyright © 2026 Oleksii Poliakov",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "data/**/*",
      "demo/**/*",
      "package.json",
      "LICENSE"
    ],
    "asarUnpack": [
      "node_modules/@manul-browser/**",
      "node_modules/manul-browser/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "ManulBrowserStudio-Setup-${version}.${ext}",
      "shortcutName": "Manul Browser Studio"
    },
    "afterPack": "scripts/after-pack.cjs"
  }
}
